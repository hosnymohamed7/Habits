{
  "expo": {
    "name": "خُطوة",
    "slug": "khatwa-habit-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "com.khatwa.habittracker",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "permissions": [
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.khatwa.habittracker",
      "supportsTablet": true
    },
    "plugins": [
      "react-native-android-widget"
    ],
    "extra": {
      "eas": {
        "projectId": "REPLACE_WITH_YOUR_PROJECT_ID"
      }
    }
  }
}
